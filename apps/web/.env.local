# Mantle Private Messenger environment
#
# This file is intentionally committed.
#
# Keep only one block uncommented.
# The app needs only:
# - VITE_RPC_URL
# - VITE_MAIN_CONNECTOR_ADDRESS
#
# Network metadata is inferred by apps/web/vite.config.ts.

# ---------------------------------------------------------------------------
# Mantle Sepolia / default
# ---------------------------------------------------------------------------

VITE_RPC_URL=https://rpc.sepolia.mantle.xyz
VITE_MAIN_CONNECTOR_ADDRESS=0xA07d7e04b13f71e8E8a094B2477c405f255F750e

